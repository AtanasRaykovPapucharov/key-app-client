      {
        "id": "golden_ratio",
        "title": "Golden Ratio",
        "description": "The special proportion φ ≈ 1.618 that appears in geometry, nature, and art.",
        "formula": "φ = (1 + √5) / 2",
        "image": "",
        "list": [
          {
            "id": "what_is_the_golden_ratio",
            "title": "What Is the Golden Ratio?",
            "description": "A line cut so that the whole is to the larger part as the larger is to the smaller.",
            "formula": "(a + b) : a = a : b = φ",
            "image": "./golden-ratio/en/what_is_the_golden_ratio.svg",
            "list": []
          },
          {
            "id": "golden_rectangle",
            "title": "The Golden Rectangle",
            "description": "A rectangle whose sides are in the ratio φ : 1 and whose layout repeats after a square is cut off.",
            "formula": "φ : 1 = 1 : (φ − 1)",
            "image": "./golden-ratio/en/golden_rectangle.svg",
            "list": []
          },
          {
            "id": "golden_spiral",
            "title": "The Golden Spiral",
            "description": "A spiral built from quarter-circles inside nested squares that grow by a factor of φ.",
            "formula": "radius × φ every quarter turn",
            "image": "./golden-ratio/en/golden_spiral.svg",
            "list": []
          },
          {
            "id": "fibonacci_numbers",
            "title": "Fibonacci Numbers",
            "description": "The sequence whose ratios approach φ as the numbers grow.",
            "formula": "F(n) = F(n−1) + F(n−2)",
            "image": "./golden-ratio/en/fibonacci_numbers.svg",
            "list": []
          },
          {
            "id": "golden_ratio_in_a_face",
            "title": "The Golden Ratio in a Face",
            "description": "Artists use φ to guide the placement of key facial features in portraits.",
            "formula": "b : a ≈ φ",
            "image": "./golden-ratio/en/golden_ratio_in_a_face.svg",
            "list": []
          },
          {
            "id": "composition_in_painting",
            "title": "Composition in Painting",
            "description": "Dividing a canvas by φ gives strong lines for placing the focal elements.",
            "formula": "width ÷ φ marks the strong line",
            "image": "./golden-ratio/en/composition_in_painting.svg",
            "list": []
          },
          {
            "id": "golden_triangle",
            "title": "The Golden Triangle",
            "description": "An isosceles triangle with angles 36°, 72°, and 72° whose equal sides are in golden ratio to the base.",
            "formula": "leg : base = φ",
            "image": "./golden-ratio/en/golden_triangle.svg",
            "list": []
          },
          {
            "id": "the_number_phi",
            "title": "The Number φ",
            "description": "The positive solution to x² = x + 1, also written as (1 + √5) / 2.",
            "formula": "φ² = φ + 1",
            "image": "./golden-ratio/en/the_number_phi.svg",
            "list": []
          },
          {
            "id": "golden_angle",
            "title": "The Golden Angle",
            "description": "A full turn split in the golden ratio gives an angle of about 137.5°.",
            "formula": "360° ÷ φ² ≈ 137.5°",
            "image": "./golden-ratio/en/golden_angle.svg",
            "list": []
          }
        ]
      },
