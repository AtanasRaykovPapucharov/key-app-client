      {
        "id": "golden_ratio",
        "title": "Златно сечение",
        "description": "Специалната пропорция φ ≈ 1.618, която се среща в геометрията, природата и изкуството.",
        "formula": "φ = (1 + √5) / 2",
        "image": "",
        "list": [
          {
            "id": "what_is_the_golden_ratio",
            "title": "Какво е златно сечение?",
            "description": "Отсечка, разделена така, че цялото да се отнася към по-голямата част както по-голямата се отнася към по-малката.",
            "formula": "(a + b) : a = a : b = φ",
            "image": "./golden-ratio/bg/what_is_the_golden_ratio.svg",
            "list": []
          },
          {
            "id": "golden_rectangle",
            "title": "Златният правоъгълник",
            "description": "Правоъгълник, чиито страни са в съотношение φ : 1 и повторя структурата си след отрязване на квадрат.",
            "formula": "φ : 1 = 1 : (φ − 1)",
            "image": "./golden-ratio/bg/golden_rectangle.svg",
            "list": []
          },
          {
            "id": "golden_spiral",
            "title": "Златната спирала",
            "description": "Спирала, построена от четвърт кръгове в вложени квадрати, които растат с коефициент φ.",
            "formula": "радиус × φ на всяка четвърт завъртане",
            "image": "./golden-ratio/bg/golden_spiral.svg",
            "list": []
          },
          {
            "id": "fibonacci_numbers",
            "title": "Числата на Фибоначи",
            "description": "Редицата, чиито отношения се доближават до φ с нарастването на числата.",
            "formula": "F(n) = F(n−1) + F(n−2)",
            "image": "./golden-ratio/bg/fibonacci_numbers.svg",
            "list": []
          },
          {
            "id": "golden_ratio_in_a_face",
            "title": "Златното сечение в лице",
            "description": "Художниците използват φ, за да подреждат ключовите черти на лицето в портрет.",
            "formula": "b : a ≈ φ",
            "image": "./golden-ratio/bg/golden_ratio_in_a_face.svg",
            "list": []
          },
          {
            "id": "composition_in_painting",
            "title": "Композиция в живописта",
            "description": "Разделянето на платно по φ дава силни линии за поставяне на централните елементи.",
            "formula": "ширина ÷ φ маркира силната линия",
            "image": "./golden-ratio/bg/composition_in_painting.svg",
            "list": []
          },
          {
            "id": "golden_triangle",
            "title": "Златният триъгълник",
            "description": "Равнобедрен триъгълник с ъгли 36°, 72° и 72°, чиито равни страни са в златно съотношение с основата.",
            "formula": "крак : основа = φ",
            "image": "./golden-ratio/bg/golden_triangle.svg",
            "list": []
          },
          {
            "id": "the_number_phi",
            "title": "Числото φ",
            "description": "Положителното решение на x² = x + 1, което може да се запише като (1 + √5) / 2.",
            "formula": "φ² = φ + 1",
            "image": "./golden-ratio/bg/the_number_phi.svg",
            "list": []
          },
          {
            "id": "golden_angle",
            "title": "Златният ъгъл",
            "description": "Пълният оборот, разделен в златното сечение, дава ъгъл около 137,5°.",
